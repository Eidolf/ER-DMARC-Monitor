# ER-DMARC-Monitor Environment Configuration
# Copy this file to '.env' and adjust the values as needed.

# ==========================================
# Database Credentials
# ==========================================
# Diese Zugangsdaten werden sowohl für die Erstellung der Datenbank 
# als auch für die Verbindung von API und DMARC-Parser genutzt.
POSTGRES_USER=dmarc_admin
POSTGRES_PASSWORD=secure_dmarc_pass_123!
POSTGRES_DB=dmarc_monitor

# ==========================================
# Admin Account Setup
# ==========================================
# Zugangsdaten für den ersten lokalen Administrator-Account.
ADMIN_USER=admin
ADMIN_EMAIL=admin@local.domain
ADMIN_PASSWORD=change_me_immediately

# ==========================================
# Security Settings
# ==========================================
# Ein sicherer Zufallsschlüssel für die JWT Token Verschlüsselung.
# (Generiere einen langen zufälligen String, z.B. mit 'openssl rand -hex 32')
JWT_SECRET=super_secret_jwt_key_for_production

# ==========================================
# SMTP & Ingestion Configuration
# ==========================================
# Die Domain(s), auf der/denen DMARC Reports empfangen werden sollen.
RECIPIENT_DOMAINS=report.dmarc.domain.com

# ==========================================
# Single Sign-On (Entra ID) - Optional
# ==========================================
# ENTRA_CLIENT_ID=your_client_id
# ENTRA_CLIENT_SECRET=your_client_secret
# ENTRA_TENANT_ID=common
# ENTRA_REDIRECT_URI=https://your-dmarc-dashboard.com/api/auth/sso/callback

# ==========================================
# System URLs
# ==========================================
# Die URL, unter der das Frontend erreichbar ist (Wichtig für CORS und Redirects).
FRONTEND_URL=http://localhost:13060
